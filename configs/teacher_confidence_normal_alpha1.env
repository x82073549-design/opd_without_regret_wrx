# Teacher-confidence token weighting overlay.
# Source this file before running on_policy_distillation.sh.
#
# All training/model/data defaults remain inherited from on_policy_distillation.sh.

export TOKEN_FEATURE_WEIGHT_ENABLE=True
export TOKEN_FEATURE_NAME=teacher_confidence
export TOKEN_FEATURE_ALPHA=2
export TOKEN_FEATURE_DIRECTION=normal
export TOKEN_FEATURE_EPS=1e-6
export TOKEN_FEATURE_MIN_WEIGHT=0.0
export EXPERIMENT_NAME=teacher_confidence_with_alpha2
